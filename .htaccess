# Shared Hosting & cPanel Apache Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive framework folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L]

    # Protect internal storage directories while allowing storage/app/public assets
    RewriteRule ^storage/(framework|logs|app/private|installed)(/.*)?$ - [F,L]

    # Prevent direct access to sensitive files
    RewriteRule ^(\.env|\.git|\.editorconfig|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|README\.md|artisan)$ - [F,L]

    # Serve static files from public/ folder if they exist
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to root index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.(env|git|svn|htaccess|htpasswd|ini|log|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>
